<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleDevelopmentRegion</key><string>ko</string>
    <!-- Korean strings live in code as keys; English in Resources/en.lproj. -->
    <key>CFBundleLocalizations</key><array><string>ko</string><string>en</string></array>
    <key>CFBundleDisplayName</key><string>$(PRODUCT_DISPLAY_NAME)</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
